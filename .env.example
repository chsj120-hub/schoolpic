# =======================================================
# 스쿨픽(School-Pic) 환경변수 템플릿 (.env.example)
# 실제 값은 .env.local 에 작성하세요.
# =======================================================

# [개발자 수신 이메일]
# ※ 절대 클라이언트에 노출되지 않는 서버 비밀 환경변수
DEVELOPER_EMAIL="chsj120@gmail.com"

# [Resend API 키]
# https://resend.com 대시보드에서 무료 발급
RESEND_API_KEY=""

# [나이스(NEIS) 교육정보 개방포털 키]
NEIS_API_KEY=""

# [Supabase 설정 (향후 DB 연결 시)]
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# [Cloudflare R2 설정 (향후 사진 클라우드 연결 시)]
CLOUDFLARE_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
NEXT_PUBLIC_R2_PUBLIC_URL=""
